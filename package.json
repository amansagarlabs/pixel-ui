{
  "name": "pixel-ui",
  "version": "0.1.0",
  "private": true,
  "description": "pixel-ui - AI Agent primitives registry",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pixel-ui/docs",
    "build:cli": "cd packages/cli && npm run build",
    "build:registry": "cd packages/registry && npm run build",
    "build:core": "cd packages/core && npm run build",
    "generate:ui-registry": "node scripts/generate-ui-registry.mjs",
    "dev": "npm run dev -w @pixel-ui/docs",
    "dev:docs": "npm run dev -w @pixel-ui/docs",
    "test": "vitest run",
    "lint": "npm run lint -w @pixel-ui/docs",
    "typecheck": "npm run typecheck -w @pixel-ui/docs"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "^1.23.0"
  }
}
